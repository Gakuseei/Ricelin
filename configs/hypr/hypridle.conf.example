general {
    lock_cmd = /home/erik/.config/hypr/scripts/lock.sh
    before_sleep_cmd = /home/erik/.config/hypr/scripts/lock.sh sleep
    after_sleep_cmd = sh -c "hyprctl dispatch dpms on; sleep 0.05; qs -c lock ipc call lock reveal >/dev/null 2>&1"
}

listener {
    timeout = 300
    on-timeout = /home/erik/.config/hypr/scripts/lock.sh
}

listener {
    timeout = 360
    on-timeout = hyprctl dispatch dpms off
    on-resume = hyprctl dispatch dpms on
}
